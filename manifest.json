{
  "id": "folio",
  "name": "Artifacts",
  "route": "/folio",
  "entry": "/apps/folio/entry.js",
  "version": "0.3.3",
  "sdk": "^1.1.1",
  "description": "Documents kept for you, your teams and the org",
  "icon": "library",
  "floors": [
    "personal",
    "team",
    "org"
  ],
  "surfaces": [
    {
      "floor": "personal",
      "slot": "card",
      "module": "./Glance"
    },
    {
      "floor": "team",
      "slot": "card",
      "module": "./Glance"
    },
    {
      "floor": "org",
      "slot": "card",
      "module": "./Glance"
    }
  ],
  "search": true,
  "storage": {
    "database": true,
    "bucket": true
  },
  "scopes": [
    "audit:write",
    "people:read",
    "notifications:send",
    "events:publish"
  ],
  "handles": [
    "document.open",
    "document.pick",
    "library.open",
    "unit.open",
    "folio.open"
  ],
  "maxUpload": 200,
  "settings": [
    {
      "id": "retentionDays",
      "label": "Keep deleted documents for",
      "detail": "After this, a deleted document’s files and text are removed for good. The activity log still names it.",
      "type": "integer",
      "unit": "days",
      "min": 1,
      "max": 3650,
      "default": 30
    }
  ],
  "orbit": false,
  "menu": [
    {
      "id": "libraries",
      "label": "Libraries",
      "icon": "folder",
      "items": [
        {
          "id": "all",
          "label": "All libraries",
          "icon": "list",
          "path": "/libraries",
          "detail": "Everything kept on this floor",
          "keywords": "documents folders shelves"
        },
        {
          "id": "published",
          "label": "Published to you",
          "icon": "inbox",
          "path": "/published",
          "detail": "What’s been put out to you, newest first",
          "keywords": "new inbox notices read"
        },
        {
          "id": "new",
          "label": "New library",
          "icon": "plus",
          "path": "/libraries/new",
          "keywords": "create add shelf"
        }
      ]
    }
  ]
}
