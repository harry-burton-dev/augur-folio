{
  "name": "augur-folio",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p run",
    "lint": "eslint .",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs && augur-app catalog",
    "check:catalog": "augur-app catalog --check",
    "release-out": "pnpm --filter ./service deploy --prod --legacy out",
    "check:app": "augur-app validate && augur-app release describe > /dev/null"
  },
  "devDependencies": {
    "@augur/app-tools": "npm:@harry-burton-dev/augur-app-tools@^0.5.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
